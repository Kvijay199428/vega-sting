<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme. Material.Light for compat with in-app dialogs, but force a black
         window background so there is no white frame between the black splash and the
         dark Compose UI. -->
    <style name="Theme.VEGASTING" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- Splash Screen Theme (Android 12+ SplashScreen API, compat back to API 26) -->
    <style name="Theme.VEGASTING.Splash" parent="Theme.SplashScreen">
        <!-- Splash background: matches the Bloomberg-terminal black of the app UI.
             Flip to @color/splash_background to a light value only when a light splash
             artwork (whose gray monogram is unreadable on black) is actually provided. -->
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- The mark, cropped from the splash artwork to a 108 dp canvas at 66 dp -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <!-- No separate icon disc behind the mark -->
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <!-- Theme to apply after splash is done -->
        <item name="postSplashScreenTheme">@style/Theme.VEGASTING</item>
    </style>

    <style name="Theme.Transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>

