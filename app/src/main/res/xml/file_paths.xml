<?xml version="1.0" encoding="utf-8"?>

<paths>

    <external-path
        name="external_files"
        path="."/>

    <external-files-path
        name="app_external"
        path="."/>

    <cache-path
        name="cache"
        path="."/>

    <!-- OTA updater: verified release APKs are published to the public
         Download/VEGA-STING/ folder (see ApkStore). On API 26-28 they are
         plain files under the external storage root, which the
         external-path entry above already covers; on API 29+ they are
         MediaStore content:// URIs handled without FileProvider.

         The legacy files-path entry is retained so an APK downloaded by an
         older build into filesDir/updates can still be shared if present. -->
    <files-path
        name="updates"
        path="updates/"/>

</paths>
