<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="toggle_recording"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_camera"
        android:shortcutShortLabel="@string/shortcut_toggle_short"
        android:shortcutLongLabel="@string/shortcut_toggle_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.vega.sting"
            android:targetClass="com.vega.sting.shortcuts.PowerToggleRecordingActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
